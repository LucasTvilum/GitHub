@page "/weather"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStore
@using Core
<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

@if (forecasts == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{ <div class="mb-2">
        <button class="btn btn-outline-secondary me-2" @onclick="ShowAll">Alle</button>
        <button class="btn btn-outline-secondary me-2" @onclick="ShowCold">Kold</button>
        <button class="btn btn-outline-secondary me-2" @onclick="ShowWarm">Varm</button>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th aria-label="Temperature in Celsius">Temp. (C)</th>
            @if (FVises)
            {

                <th aria-label="Temperature in Farenheit">Temp. (F)</th>
            }
            <th>Summary</th>
            <th>Location</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var forecast in FilteredForecasts.Take(visibleCount))
        {
            <tr>
                <td>@forecast.Date.ToShortDateString()</td>
                <td>@forecast.TemperatureC</td>
                @if (FVises)
                {
                    <td>@forecast.TemperatureF</td>
                }
                <td>@forecast.Summary</td>
                <td>@forecast.Location</td>
            </tr>
        }
        </tbody>
    </table>
    
    <div class="mb-3">
        <button class="btn btn-outline-secondary me-2" @onclick="ShowLess" disabled="@(visibleCount <= 1)">Vis mindre...</button>
        <button class="btn btn-outline-secondary me-2" @onclick="ShowMore" disabled="@(visibleCount >= FilteredForecasts.Count())">Vis mere...</button>
        <button class="btn btn-primary" @onclick="ToggleF">@TextOnButton()</button>
    </div>
}
@code {
    private WeatherForecast[]? forecasts;
    private bool FVises = true;
    private int visibleCount = 1;
    private const string Key = "Weather.visibleCount";

    // Simpelt filterflag: "All" | "Cold" | "Warm"
    private string filter = "All";

    // Filtreret sekvens baseret på filteret
    private IEnumerable<WeatherForecast> FilteredForecasts =>
        forecasts is null ? Enumerable.Empty<WeatherForecast>() :
        filter == "Cold" ? forecasts.Where(f => f.TemperatureC < 10) :
        filter == "Warm" ? forecasts.Where(f => f.TemperatureC >= 10) :
        forecasts;

    // Knap-handlers
    private void ShowAll()  => filter = "All";
    private void ShowCold() => filter = "Cold";
    private void ShowWarm() => filter = "Warm";

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("http://localhost:5107/api/vejr");

        if (await localStore.ContainKeyAsync(Key))
            visibleCount = Math.Clamp(await localStore.GetItemAsync<int>(Key), 1, FilteredForecasts.Count());
        else
            visibleCount = Math.Min(3, FilteredForecasts.Count());
    }

    private string TextOnButton() => FVises ? "Skjul F" : "Vis F";

   
    private void ToggleF() => FVises = !FVises;

    private async Task ShowMore()
    {
        if (!FilteredForecasts.Any()) return;
        visibleCount = Math.Clamp(visibleCount + 3, 1, FilteredForecasts.Count());
        await localStore.SetItemAsync(Key, visibleCount);
    }

    private async Task ShowLess()
    {
        if (!FilteredForecasts.Any()) return;
        visibleCount = Math.Clamp(visibleCount - 3, 1, FilteredForecasts.Count());
        await localStore.SetItemAsync(Key, visibleCount);
    }
}


