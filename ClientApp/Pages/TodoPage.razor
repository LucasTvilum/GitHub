@page "/TodoPage"
@inject HttpClient Http
@using ClientApp.Service
@using Core.Models

<h1>Todo (@CountMissing() mangler)</h1>

<div class="todo-input-row">
    <InputText @bind-Value="newTodoTitle" placeholder="Skriv en ny todo"></InputText>
    <button class="btn btn-primary" @onclick="AddTodo">Opret</button>
</div>

<ul>

    <table class="table">
        <thead>
        <tr>
            <th scope="row">ToDo</th>
            <th scope="row">Number</th>
            <th scope="row">IsDone</th>
            
        </tr>
        </thead>
        <tbody>
        @if (todos != null)
        {
            
            foreach (TodoItem todo in todos)
            {
                <tr>
                    <th scope="col">@todo?.Title</th>    
                    <th scope="col">@todo?.IsDone</th>
                    <div class="col-12 mb-3">
                        <button class="btn btn-primary" @onclick="() => Delete(todo)">Delete</button>
                    </div>
                </tr>
            }
        }
        </tbody>
    </table>

</ul>


@code {
   private TodoItem[]? items;
    [Inject]
    private ITodoService todoservice { get; set; }
    
    private List<TodoItem> todos = new();
    private string newTodoTitle = "";
    private TodoItem[]? todolistimport;
    

    protected override async Task OnInitializedAsync()
    {
        items = await todoservice.GetAll();
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        todolistimport = await todoservice.GetAll();
        if (todolistimport != null)
        {
            todos = todolistimport.ToList();
        }
    }

    private async Task AddTodo()
    {
      if (newTodoTitle != "")
      {
          TodoItem newtodo = new TodoItem { IsDone = false, Title = newTodoTitle};
          await todoservice.Add(newtodo);
      }

      await LoadTodos();
      StateHasChanged();
    }
   

    private async Task Delete(TodoItem t)
    {
       Console.WriteLine("gg");

       await todoservice.Delete(t.Id);
       await LoadTodos();
       StateHasChanged();
    }

    private int CountMissing() => todos.Count(x => !x.IsDone);
}